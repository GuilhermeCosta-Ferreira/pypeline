@startuml
left to right direction
skinparam linetype ortho
skinparam class {
    BackgroundColor<<implemented>> #D5F5D5
    BorderColor<<implemented>> #2E7D32
    FontColor<<implemented>> #1B5E20

    BackgroundColor<<partial>> #FFF3CD
    BorderColor<<partial>> #B8860B
    FontColor<<partial>> #7A5600

    BackgroundColor<<planned>> #F8D7DA
    BorderColor<<planned>> #B02A37
    FontColor<<planned>> #842029

    BackgroundColor<<external>> #E3F2FD
    BorderColor<<external>> #1565C0
    FontColor<<external>> #0D47A1
}

legend right
|= Colour |
|<#D5F5D5> Implemented |
|<#FFF3CD> Partially implemented |
|<#F8D7DA> Planned / not implemented |
|<#E3F2FD> External dependency |
endlegend

' 0 = hide dependency lines
' 1 = show dependency lines
!$SHOW_DEPENDENCIES = 1


'=============================================================================='
'Service Layer'
'=============================================================================='
package "Service Layer" #E8F5E9 {
}


'=============================================================================='
'Model Domain'
'=============================================================================='
package "Model Domain Layer" #FFF8E1 {
    abstract class Step <<implemented>> {
        + scope: ClassVar[StepScope]
        + requires: ClassVar[list[type[Step]]]

        + apply(In): Out
        + run(In): Out
        + validate_input(In): None
        + validate_output(Out): None
    }

    package "Registries"{
        class Registry <<implemented>> {
            - _entries: ClassVar[dict[str, type]]

            + register(key: str): Callable[[type[T]], type[T]]
            + get(key: str): T
            + get_type(key: str): type[T]
            + known_keys(): set[str]
            + key_of(target: T | type[T]): str
            + has(key: str): bool
        }

        class StepRegistry <<implemented>> {
        }
        StepRegistry --|> Registry
    }

    package "Protocol"{
        class ProtocolDraft <<implemented>> {
            + data: dict
        }


        class Protocol <<implemented>> {
            + global_settings: GlobalSettings
            + input_settings: InputSettings
            + output_settings: OutputSettings
            + steps: list[Step]
            + steps_names(self): list[str]
        }
        Protocol o-- Step


        class ProtocolBuilder <<implemented>> {
            + build(draft: ProtocolDraft): Protocol

            + build_section(cls: Any, data: dict, section: str): Any
            + build_steps(raw_steps: list[dict]): list[Step]
            + validate_protocol(protocol: Protocol): None
        }
        !if ($SHOW_DEPENDENCIES == 1)
            ProtocolBuilder ..> ProtocolDraft
            ProtocolBuilder ..> Protocol
            ProtocolBuilder ..> Step
        !endif

        package "Settings"{
            class GlobalSettings <<implemented>> {
                + protocol_name: str
                + check_scope: bool
            }


            class InputSettings <<implemented>> {
                + load_as: FormatsMap
                + sources: list[Source]
            }
            InputSettings o-- Source


            class OutputSettings <<implemented>> {
                + out_dir: Path
                + fmts: FormatsMap
                + save_all_intermediates: bool
                + save_points: list[SavePoint]

            }
            OutputSettings o-- SavePoint


            class SavePoint <<implemented>> {
                + after: str
                + occurrence: int
                + subdir: Path | None
                + fmts: FormatsMap
            }


            class Source <<implemented>> {
            + path: Path
            + load_as: FormatsMap
            }
        }
        Protocol --> GlobalSettings
        Protocol --> InputSettings
        Protocol --> OutputSettings
    }
}


'=============================================================================='
'Adapter Layer'
'=============================================================================='
package "Adapter Layer" #E3F2FD {
}

@enduml
